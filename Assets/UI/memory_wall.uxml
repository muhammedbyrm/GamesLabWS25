<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/MemoryWallStyle.uss?fileID=7433441132597879392&amp;guid=5fc28970558559d4885a3c174bb4cb49&amp;type=3#MemoryWallStyle" />
    <ui:VisualElement name="NoteSystem" enabled="true" style="background-image: url(&quot;project://database/Assets/Images/MemoryWall/noteBackground.png?fileID=2800000&amp;guid=26dcbff11567ada4c97f261ae57c3716&amp;type=3#noteBackground&quot;); width: 80%; max-width: 1280px; min-width: 800px; height: 70%; max-height: 720px; min-height: 500px; margin: auto; justify-content: center; align-items: center; flex-direction: column; display: flex; background-color: rgb(255, 255, 255);">
        <ui:VisualElement name="headerBar" enabled="true" style="background-size: 100% 60px; position: absolute; align-items: center; justify-content: center; top: 0; left: 0; right: 0; flex-direction: row; height: 8%; min-height: 50px; max-height: 80px;">
            <ui:Label text="MEMORY WALL" name="title" style="font-size: 42px; -unity-font-style: bold; -unity-text-align: middle-center; color: rgb(255, 255, 255); width: 100%; height: 100%; position: absolute; top: 0; -unity-font-definition: url(&quot;project://database/Assets/Font/Nosifer-Regular.ttf?fileID=12800000&amp;guid=30e0a51b7bf96d74393bbe145ed30e15&amp;type=3#Nosifer-Regular&quot;);" />
            <ui:Button text="X" name="closeButton" enable-rich-text="true" style="background-color: rgb(255, 0, 0); color: rgb(255, 255, 255); font-size: 24px; -unity-font-style: bold; width: 60px; height: 100%; position: absolute; right: 0; top: 0; -unity-font-definition: url(&quot;project://database/Assets/Font/MetalMania-Regular.ttf?fileID=12800000&amp;guid=f583d721ccf975441a1866d999950121&amp;type=3#MetalMania-Regular&quot;); min-width: 50px; max-width: 80px;" />
        </ui:VisualElement>
        <ui:Label name="DeleteIntro" triple-click-selects-line="false" style="width: 40%; min-width: 300px; position: absolute; top: 10%; left: 2%; color: rgb(255, 255, 255); font-size: 16px; -unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Assets/Font/MetalMania-Regular.ttf?fileID=12800000&amp;guid=f583d721ccf975441a1866d999950121&amp;type=3#MetalMania-Regular&quot;);" />
        <ui:ScrollView name="MessageContainer" style="height: 50%; width: 95%; position: absolute; top: 20%; display: flex; -unity-font-definition: url(&quot;project://database/Assets/Font/MetalMania-Regular.ttf?fileID=12800000&amp;guid=f583d721ccf975441a1866d999950121&amp;type=3#MetalMania-Regular&quot;); min-height: 200px;">
            <ui:Label text="IMPORTANT MESSAGE!!!" name="message" style="width: 99.8%; background-color: rgb(207, 44, 44); color: white; height: auto; min-height: 50px; padding: 10px; font-size: 20px; -unity-font-style: bold; display: none; -unity-font-definition: url(&quot;project://database/Assets/Font/Nosifer-Regular.ttf?fileID=12800000&amp;guid=30e0a51b7bf96d74393bbe145ed30e15&amp;type=3#Nosifer-Regular&quot;); -unity-text-align: middle-center; margin-bottom: 5px;" />
        </ui:ScrollView>
        <ui:VisualElement name="ButtonContainer" style="position: absolute; bottom: 8%; left: 0; right: 0; flex-direction: row; justify-content: center; align-items: center; height: 10%; min-height: 60px;">
            <ui:Button text="Delete Note" name="DeleteNote" enable-rich-text="true" style="width: 22%; min-width: 200px; max-width: 300px; background-color: rgb(241, 8, 8); -unity-font-style: bold; font-size: 22px; height: 80%; margin-right: 2%; -unity-font-definition: url(&quot;project://database/Assets/Font/Nosifer-Regular.ttf?fileID=12800000&amp;guid=30e0a51b7bf96d74393bbe145ed30e15&amp;type=3#Nosifer-Regular&quot;); min-height: 50px;" />
            <ui:Button text="Add New Note" name="AddNoteButton" style="width: 22%; min-width: 200px; max-width: 300px; background-color: rgb(61, 255, 20); color: black; -unity-font-style: bold; font-size: 22px; -unity-font-definition: url(&quot;project://database/Assets/Font/Nosifer-Regular.ttf?fileID=12800000&amp;guid=30e0a51b7bf96d74393bbe145ed30e15&amp;type=3#Nosifer-Regular&quot;); height: 80%; min-height: 50px;" />
        </ui:VisualElement>
        <ui:VisualElement name="AddNotePanel" style="display: none; width: 100%; position: absolute; height: 100%; top: 0; left: 0; flex-direction: column; padding: 10px; background-color: rgb(0, 88, 88); background-image: url(&quot;project://database/Assets/Images/MemoryWall/addNote.png?fileID=2800000&amp;guid=e873c04c5c8249a46acbb6a9eb9bb641&amp;type=3#addNote&quot;);">
            <ui:Button name="CloseAddNotePanel" text="X" style="width: 40px; height: 35px; position: absolute; right: 0; top: 0; background-color: red; color: white; -unity-font-definition: url(&quot;project://database/Assets/Font/MetalMania-Regular.ttf?fileID=12800000&amp;guid=f583d721ccf975441a1866d999950121&amp;type=3#MetalMania-Regular&quot;); font-size: 20px;" />
            <ui:Label text="Create your message by choosing words from the categories below." name="Intro" style="width: 100%; max-width: 650px; font-size: 16px; -unity-font-style: bold; color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Assets/Font/MetalMania-Regular.ttf?fileID=12800000&amp;guid=f583d721ccf975441a1866d999950121&amp;type=3#MetalMania-Regular&quot;); margin-bottom: 10px; margin-top: 8%;" />
            <ui:VisualElement name="PreviewContainer" style="flex-direction: column; margin-bottom: 8px; -unity-font-definition: url(&quot;project://database/Assets/Font/MetalMania-Regular.ttf?fileID=12800000&amp;guid=f583d721ccf975441a1866d999950121&amp;type=3#MetalMania-Regular&quot;);">
                <ui:Label text="Your Note:" name="Label" style="color: white; font-size: 18px; -unity-font-definition: url(&quot;project://database/Assets/Font/MetalMania-Regular.ttf?fileID=12800000&amp;guid=f583d721ccf975441a1866d999950121&amp;type=3#MetalMania-Regular&quot;);" />
                <ui:Label name="PreviewText" style="color: rgb(0, 0, 0); height: 40px; min-height: 30px; background-color: rgb(50, 50, 50); padding-left: 4px; padding-top: 5px; -unity-font-definition: url(&quot;project://database/Assets/Font/MetalMania-Regular.ttf?fileID=12800000&amp;guid=f583d721ccf975441a1866d999950121&amp;type=3#MetalMania-Regular&quot;); font-size: 14px; background-image: url(&quot;project://database/Assets/Images/MemoryWall/white.png?fileID=2800000&amp;guid=0e25497a8e129de428240770eaf932aa&amp;type=3#white&quot;); -unity-background-image-tint-color: rgb(255, 255, 255); -unity-font-style: bold;" />
            </ui:VisualElement>
            <ui:VisualElement name="CategoryTabs" style="flex-direction: row; margin-bottom: 8px; -unity-font-definition: url(&quot;project://database/Assets/Font/MetalMania-Regular.ttf?fileID=12800000&amp;guid=f583d721ccf975441a1866d999950121&amp;type=3#MetalMania-Regular&quot;);">
                <ui:Button name="TabActions" text="Actions" style="flex-grow: 1; margin-right: 4px; -unity-font-definition: url(&quot;project://database/Assets/Font/MetalMania-Regular.ttf?fileID=12800000&amp;guid=f583d721ccf975441a1866d999950121&amp;type=3#MetalMania-Regular&quot;); font-size: 16px; padding: 5px; background-color: rgb(233, 193, 0);" />
                <ui:Button name="TabPlaces" text="Places" style="flex-grow: 1; margin-right: 4px; font-size: 16px; padding: 5px; background-color: rgb(234, 193, 0);" />
                <ui:Button name="TabObjects" text="Objects" style="flex-grow: 1; margin-right: 4px; font-size: 16px; padding: 5px; background-color: rgb(234, 193, 0);" />
                <ui:Button name="TabNumbers" text="Numbers" style="flex-grow: 1; margin-right: 4px; font-size: 16px; padding: 5px; background-color: rgb(234, 193, 0);" />
                <ui:Button name="TabCommon" text="Common" style="flex-grow: 1; font-size: 16px; padding: 5px; background-color: rgb(234, 193, 0);" />
            </ui:VisualElement>
            <ui:ScrollView name="WordGrid" style="flex: 1 1 auto; max-height: 300px; background-color: rgb(30, 30, 30); -unity-font-definition: url(&quot;project://database/Assets/Font/MetalMania-Regular.ttf?fileID=12800000&amp;guid=f583d721ccf975441a1866d999950121&amp;type=3#MetalMania-Regular&quot;); min-height: 150px; background-image: url(&quot;project://database/Assets/Images/MemoryWall/white.png?fileID=2800000&amp;guid=0e25497a8e129de428240770eaf932aa&amp;type=3#white&quot;); -unity-background-image-tint-color: rgb(125, 188, 154); display: flex;" />
            <ui:VisualElement name="Controls" style="flex-direction: row; justify-content: flex-end; margin-top: 6px; -unity-font-definition: url(&quot;project://database/Assets/Font/Nosifer-Regular.ttf?fileID=12800000&amp;guid=30e0a51b7bf96d74393bbe145ed30e15&amp;type=3#Nosifer-Regular&quot;);">
                <ui:Button name="ClearBtn" text="Clear" style="width: 120px; height: 35px; margin-right: 10px; min-width: 100px; font-size: 18px;" />
                <ui:Button name="SaveBtn" text="Save" style="width: 120px; height: 35px; background-color: rgb(61, 255, 20); min-width: 100px; font-size: 18px;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="DetailedMessage" style="flex-grow: 1; align-items: center; justify-content: center; align-self: center; width: 60%; max-width: 800px; min-width: 400px; position: absolute; height: 60%; min-height: 300px; top: 20%; background-color: rgb(108, 108, 107); display: none; -unity-font-definition: url(&quot;project://database/Assets/Font/MetalMania-Regular.ttf?fileID=12800000&amp;guid=f583d721ccf975441a1866d999950121&amp;type=3#MetalMania-Regular&quot;); background-image: url(&quot;project://database/Assets/Images/MemoryWall/white.png?fileID=2800000&amp;guid=0e25497a8e129de428240770eaf932aa&amp;type=3#white&quot;); -unity-background-image-tint-color: rgb(195, 195, 195);">
            <ui:Label text="Sender" name="SenderLabel" style="width: auto; height: 30px; position: absolute; top: 5%; left: 3%; -unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Assets/Font/MetalMania-Regular.ttf?fileID=12800000&amp;guid=f583d721ccf975441a1866d999950121&amp;type=3#MetalMania-Regular&quot;); color: rgb(0, 0, 0); font-size: 18px;" />
            <ui:ScrollView name="FullMessageScroll" style="position: absolute; height: 60%; width: 85%; top: 25%; left: 7.5%;">
                <ui:Label text="Message" name="FullMessage" emoji-fallback-support="false" style="width: 98%; -unity-font-definition: url(&quot;project://database/Assets/Font/MetalMania-Regular.ttf?fileID=12800000&amp;guid=f583d721ccf975441a1866d999950121&amp;type=3#MetalMania-Regular&quot;); color: rgb(0, 0, 0); font-size: 16px; white-space: normal;" />
            </ui:ScrollView>
            <ui:Button text="X" name="CloseDetailPanel" style="position: absolute; top: 0; right: 0; height: 36px; width: 53px; background-color: red; -unity-font-definition: url(&quot;project://database/Assets/Font/MetalMania-Regular.ttf?fileID=12800000&amp;guid=f583d721ccf975441a1866d999950121&amp;type=3#MetalMania-Regular&quot;); font-size: 20px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>