.message-item {
    background-color: rgba(30, 0, 50, 0.65);      /* dark purple base */
    border: 2px solid rgba(255, 0, 255, 0.7);     /* neon magenta border */
    color: #FFFFFF;                         /* soft neon text */
    padding: 18px;
    margin: 10px 0;
    border-radius: 14px;
    -unity-text-align: middle-center;
    font-size: 20px;
    font-weight: bold;
    box-shadow: 0 0 16px rgba(255, 0, 255, 0.35);   /* outer glow */
    transition: 0.15s ease-out;
}

.message-item:hover {
    background-color: rgba(50, 0, 80, 0.85);       /* brighter purple */
    border-color: rgba(255, 0, 255, 1.0);
    transform: scale(1.04);
    box-shadow: 0 0 24px rgba(255, 0, 255, 0.55);
    cursor: pointer;
}

.selected-note {
    background-color: rgba(60, 0, 120, 0.85) !important;
    border-left: 5px solid #FF00FF !important;
    color: #FFFFFF !important;
}

.message-item {
    transition: 0.25s ease;
}

Button {
    border-radius: 10px;
}


.notification {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%) translateY(20px);
    padding: 12px 22px;
    opacity: 0;

    background-color: rgba(0,0,0,0.75);
    color: white;
    font-size: 17px;
    border-radius: 10px;

    transition: opacity 0.35s ease, transform 0.35s ease;
}

.notification.showing {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
}
