<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" editor-extension-mode="False">
    <ui:VisualElement name="root" style="width: 100%; height: 100%; position: absolute; background-color: rgb(18, 18, 18); justify-content: center; align-items: center;">
        <ui:VisualElement name="lensContainer" style="width: 55%; height: 55%; max-width: 600px; max-height: 600px; min-width: 320px; min-height: 320px; justify-content: center; align-items: center;">
            <ui:VisualElement name="outerRing" style="position: absolute; width: 100%; height: 100%; border-radius: 999px; border-width: 2px; border-color: rgba(255, 255, 255, 0.1);" />
            <ui:VisualElement name="lens" style="width: 92%; height: 92%; border-radius: 999px; overflow: hidden; justify-content: center; align-items: center; background-color: rgb(25, 25, 25); border-width: 3px; border-color: rgba(100, 100, 100, 0.3);">
                <ui:VisualElement name="imageHolder" style="width: 100%; height: 100%; background-repeat: no-repeat; background-position: center; background-size: cover;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="hudPanel" style="position: absolute; top: 20px; left: 20px; padding: 12px 16px; background-color: rgba(0, 0, 0, 0.45); border-radius: 10px; border-width: 1px; border-color: rgba(255, 255, 255, 0.1); flex-direction: column; min-width: 150px;">
            <ui:Label name="imageLabel" text="Image 1/3" style="color: white; unity-font-size: 15px; -unity-font-style: bold;" />
            <ui:Label name="zoomLabel" text="Zoom 0%" style="color: white; unity-font-size: 14px; margin-top: 4px;" />
            <ui:VisualElement name="zoomBar" style="width: 100%; height: 6px; background-color: rgb(51, 51, 51); margin-top: 8px; border-radius: 3px;">
                <ui:VisualElement name="zoomFill" style="width: 0%; height: 100%; background-color: rgb(0, 255, 170); border-radius: 3px;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="infoPanel" style="position: absolute; bottom: 8%; left: 50%; translate: -50% 0; flex-direction: column; align-items: center; padding: 16px 32px; background-color: rgba(30, 30, 30, 0.85); border-radius: 12px; border-width: 1px; border-color: rgba(255, 255, 255, 0.1);">
            <ui:Label name="instructionLabel" text="Press E for Next Image" style="color: rgba(255, 255, 255, 0.95); unity-font-size: 18px; -unity-font-style: bold; unity-text-align: middle-center; margin-bottom: 4px; letter-spacing: 0.5px;" />
            <ui:VisualElement name="keyIndicator" style="width: 32px; height: 32px; background-color: rgba(50, 50, 50, 0.8); border-radius: 6px; border-width: 2px; border-color: rgba(120, 120, 120, 0.6); justify-content: center; align-items: center; margin-top: 8px;">
                <ui:Label text="E" style="color: rgba(255, 255, 255, 0.9); unity-font-size: 16px; -unity-font-style: bold; unity-text-align: middle-center;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="escTopPanel" style="position: absolute; top: 4%; left: 50%; translate: -50% 0; padding: 10px 24px; background-color: rgba(30, 30, 30, 0.85); border-radius: 10px; border-width: 1px; border-color: rgba(255, 255, 255, 0.12); justify-content: center; align-items: center;">
            <ui:Label name="escTopLabel" text="Press ESC to  Exit Microscope" style="color: rgba(255, 255, 255, 0.85); unity-font-size: 15px; -unity-font-style: bold; unity-text-align: middle-center; letter-spacing: 0.3px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
