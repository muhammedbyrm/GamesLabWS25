.fade-panel {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgb(0, 0, 0);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 4s;
    transition-timing-function: ease-in-out;
    picking-mode: ignore;
}

.fade-in {
    opacity: 1;
}

.credits-panel {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgb(0, 0, 0);
    justify-content: center;
    align-items: center;
    overflow: hidden;
    picking-mode: ignore;
}

.hidden {
    display: none;
}

.credits-scroller {
    position: absolute;
    width: 100%;
    align-items: center;
    top: 100%;
    transition-property: top;
    transition-duration: 15s;
    transition-timing-function: linear;
    picking-mode: ignore;
}

.credits-scroll {
    top: -120%;
}

.credits-title {
    font-size: 60px;
    color: white;
    -unity-font-style: bold;
    margin-bottom: 80px;
    -unity-text-align: middle-center;
}

.credits-role {
    font-size: 32px;
    color: rgb(200, 200, 200);
    -unity-font-style: bold;
    margin-bottom: 10px;
    -unity-text-align: middle-center;
}

.credits-name {
    font-size: 28px;
    color: white;
    margin-bottom: 5px;
    -unity-text-align: middle-center;
}

.credits-spacer {
    height: 40px;
}

.credits-thanks {
    font-size: 50px;
    color: white;
    -unity-font-style: bold;
    margin-top: 80px;
    -unity-text-align: middle-center;
}