#game-title {
    letter-spacing: 4px;
    text-shadow: 0 3px 16px rgba(0,0,0,0.85);
}

.menu-button {
    border-radius: 14px;
    box-shadow: 0 8px 26px rgba(0,0,0,0.45);

    transition-property: background-color, box-shadow, transform;
    transition-duration: 0.18s;
}

.menu-button:hover {
    box-shadow: 0 14px 36px rgba(0,0,0,0.55);
    transform: scale(1.04);
}

.menu-button:active {
    transform: scale(0.97);
    box-shadow: 0 6px 18px rgba(0,0,0,0.4);
}


#btn-start {
    background-color: rgba(120, 220, 140, 0.9);
    color: #0f2a18;
}

#btn-start:hover {
    background-color: rgba(140, 235, 160, 0.95);
}


#btn-instructions {
    background-color: rgba(120, 170, 255, 0.9);
    color: #0f1f3a;
}

#btn-instructions:hover {
    background-color: rgba(150, 195, 255, 0.95);
}


#btn-exit {
    background-color: rgba(255, 110, 110, 0.88);
    color: #2a0000;
}

#btn-exit:hover {
    background-color: rgba(255, 85, 85, 0.96);
}

#credits-footer {
    text-shadow: 0 2px 8px rgba(0,0,0,0.6);
}
