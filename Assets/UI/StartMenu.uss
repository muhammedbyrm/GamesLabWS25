#game-title {
    letter-spacing: 4px;
    color: white;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    -unity-text-outline-color: rgba(0, 0, 0, 0.85);
    -unity-text-outline-width: 2px;
}

.menu-button {
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
    transition-duration: 0.2s;
}

.menu-button:hover {
    scale: 1.04 1.04;
}

.menu-button:active {
    scale: 0.97 0.97;
}

#btn-start {
    background-color: rgba(120, 220, 140, 0.9);
    color: rgb(15, 42, 24);
}

#btn-start:hover {
    background-color: rgba(140, 235, 160, 0.95);
}

#btn-instructions {
    background-color: rgba(120, 170, 255, 0.9);
    color: rgb(15, 31, 58);
}

#btn-instructions:hover {
    background-color: rgba(150, 195, 255, 0.95);
}

#btn-exit {
    background-color: rgba(255, 110, 110, 0.88);
    color: rgb(42, 0, 0);
}

#btn-exit:hover {
    background-color: rgba(255, 85, 85, 0.96);
}

#credits-footer {
    color: rgba(255, 255, 255, 0.6);
    -unity-text-align: lower-center;
}