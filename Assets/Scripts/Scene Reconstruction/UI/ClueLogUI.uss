/* ADD THIS AT THE TOP */
.hidden {
    display: none;
    opacity: 0;
}

:root {
    --text-main: #FFFFFF;
    --accent: #FF4B4B;
}

.thought-panel {
    display: flex;
    position: absolute;
    top: 5%;
    right: 3%;
    background-color: rgba(10, 10, 25, 0.85);
    border-radius: 20px;
    border-width: 2px;
    border-color: rgba(180, 50, 50, 0.3);
    flex-direction: column;
    padding: 20px;
}

.thought-title {
    font-size: 26px;
    -unity-font-style: bold;
    margin-bottom: 20px;
    -unity-text-align: middle-center;
    color: white;
}

.thought-list {
    flex-direction: column-reverse;
    align-items: flex-end;
}

.ThoughtBubble {
    margin-bottom: 16px;
    padding: 16px 20px;
    background-color: rgba(10, 10, 10, 0.6);
    border-radius: 20px 20px 20px 4px;
    max-width: 340px;
    opacity: 0;
    transition: opacity 0.8s ease-out;
}

.ThoughtBubble.visible {
    opacity: 1;
}

.thought-bubble-title {
    font-size: 14px;
    -unity-font-style: bold;
    margin-bottom: 2px;
    color: var(--text-main);
}

.thought-bubble-summary {
    font-size: 12px;
    color: #cccccc;
    white-space: normal;
}