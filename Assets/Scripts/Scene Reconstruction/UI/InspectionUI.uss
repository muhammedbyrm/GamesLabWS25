.root-full {
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
    /* Align children to bottom-left */
    align-items: flex-end;      /* Vertical: bottom */
    justify-content: flex-start; /* Horizontal: left */
    padding: 40px;              /* Safe margin from screen edges */
}


.backdrop {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.4); /* Light dimming for focus */
}

.inspection-panel {
    /* Wider and shorter box */
    width: 700px;               /* Fixed wide width */
    max-width: 80%;             /* Responsive fallback */
    min-height: 140px;          /* Minimum height */
    max-height: 40%;            /* Doesn't take too much vertical space */
    padding: 28px 32px;         /* Comfortable inner spacing */
    background-image: url("Assets/speech3.png");
    -unity-background-scale-mode: scale-and-crop;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.9);
    border-radius: 12px;
    border-left-width: 4px;
    border-left-color: turquoise;
    flex-direction: column;
    align-items: flex-start;
}

.inspection-title {
    font-size: 18px;
    -unity-font-style: italic;
    margin-bottom: 10px;
    -unity-text-align: lower-left;
    color: whitesmoke;
    opacity: 0.85;
}

.inspection-text {
    font-size: 20px;
    line-height: 1.45;
    -unity-text-align: lower-left;
    white-space: normal;
    color: white;
    flex-grow: 1;
}

.inspection-hint {
    font-size: 14px;
    color: var(--text-muted);
    align-self: flex-end;
    margin-top: 16px;
    opacity: 0.7;
}