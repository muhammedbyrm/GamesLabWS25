.root-full {
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
    align-items: flex-end;
    justify-content: flex-start;
    padding: 40px;
}

.backdrop {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.4);
}

.inspection-panel {
    width: 700px;
    max-width: 80%;
    min-height: 140px;
    max-height: 40%;
    padding: 28px 32px;
    background-image: url("project://database/Assets/Scripts/Scene%20Reconstruction/UI/Assets/speech3.png?fileID=2800000&guid=9f9096779597d4badafa1303e9555cb8&type=3#speech3");
    -unity-background-scale-mode: scale-and-crop;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.9);
    border-radius: 12px;
    border-left-width: 4px;
    border-left-color: turquoise;
    flex-direction: column;
    align-items: flex-start;
}

.inspection-title {
    font-size: 18px;
    -unity-font-style: italic;
    margin-bottom: 10px;
    -unity-text-align: lower-left;
    color: whitesmoke;
    opacity: 0.85;
}

.inspection-text {
    font-size: 20px;
    line-height: 1.45;
    -unity-text-align: lower-left;
    white-space: normal;
    color: white;
    flex-grow: 1;
}

.inspection-hint {
    font-size: 30px;
    color: rgb(255, 255, 255);
    align-self: flex-end;
    margin-top: 16px;
    opacity: 0.7;
    -unity-text-outline-color: rgb(255, 255, 255);
    -unity-text-align: upper-left;
    -unity-font-style: normal;
}
