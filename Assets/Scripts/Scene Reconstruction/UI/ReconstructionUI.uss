:root {
    --accent: #FF4B4B;
    --bg-dark: rgba(10, 10, 20, 0.98);
    --slot-bg: rgba(255, 255, 255, 0.05);
}

.hidden {
    display: none;
    opacity: 0;
}

.reconstruction-root {
    padding: 60px;
    background-color: var(--bg-dark);
    transition: opacity 0.6s ease-in-out;
    width: 100%;
    height: 100%;
}

.reconstruction-instruction {
    font-size: 28px;
    -unity-font-style: bold;
    margin-bottom: 40px;
    -unity-text-align: middle-center;
    color: var(--accent);
}

.timeline {
    flex-direction: row;
    justify-content: center;
    gap: 20px;
    margin-bottom: 60px;
}

.slot {
    width: 200px;
    height: 140px;
    background-color: var(--slot-bg);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgba(255, 75, 75, 0.2);
    justify-content: center;
    align-items: center;
}

.clue-pool {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
    margin-bottom: 40px;
}

.ClueCard {
    width: 180px;
    height: 120px;
    background-color: #222;
    border-radius: 4px;
    color: white;
    padding: 10px;
    white-space: normal;
    -unity-font-style: bold;
    border-width: 1px;
    border-color: #444;
}

.confirm-button {
    width: 200px;
    height: 50px;
    align-self: center;
    background-color: var(--accent);
    color: white;
    -unity-font-style: bold;
    border-radius: 4px;
}